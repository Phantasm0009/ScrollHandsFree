{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "ScrollHandsFree",
  "version": "1.3.0",
  "description": "A calm reading remote for hands-free auto-scrolling, voice commands, and page focus.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "toggle-scroll": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Start or pause scrolling"
    },
    "stop-scroll": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Stop scrolling and end the session"
    },
    "speed-up": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Increase scroll speed"
    },
    "speed-down": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Decrease scroll speed"
    },
    "toggle-voice-control": {
      "description": "Toggle voice commands on/off"
    }
  }
}
